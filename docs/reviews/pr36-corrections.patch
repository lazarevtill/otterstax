@@ -0,0 +1,87 @@
+import unittest
+from unittest.mock import Mock
+
+from sync_to_gitea import Sync
+
+
+class ReconcileTests(unittest.TestCase):
+    def fixture(self, existing="", previous=None, force=False):
+        sync = Sync({"GITEA_URL": "https://gitea.invalid", "GITEA_REPO": "owner/repo", "REPO": "owner/repo",
+                     "SKIP_LABEL": "no copy gitea", "INPUT_FORCE": str(force).lower()})
+        sync.github = Mock(return_value={"merged_at": "2026-10-12", "base": {"ref": "main"}, "labels": [],
+                                        "head": {"sha": "a" * 40}, "merge_commit_sha": "b" * 40,
+                                        "title": "change", "html_url": "https://github.invalid/pull/1", "body": "review body"})
+        sync.existing_pull = Mock(return_value=previous)
+        sync.gitea = Mock(return_value={"number": 1})
+        sync.command = Mock(side_effect=lambda *args, **kwargs: existing if "ls-remote" in args else "c" * 40)
+        return sync
+
+    def test_retry_repairs_pr_without_pushing_existing_branch(self):
+        sync = self.fixture("d" * 40 + "\trefs/heads/github/pr-1")
+        sync.copy_one(1)
+        self.assertFalse(any("push" in call.args for call in sync.command.call_args_list))
+        self.assertEqual(sync.gitea.call_args.args[:2], ("POST", "pulls"))
+
+    def test_closed_or_merged_copy_is_not_duplicated(self):
+        for state in ("open", "closed"):
+            sync = self.fixture("d" * 40 + "\trefs/heads/github/pr-1", {"state": state})
+            sync.copy_one(1)
+            sync.gitea.assert_not_called()
+            self.assertEqual(sync.command.call_count, 1)
+
+    def test_force_uses_observed_oid_lease(self):
+        sync = self.fixture("d" * 40 + "\trefs/heads/github/pr-1", force=True)
+        sync.copy_one(1)
+        push = next(call for call in sync.command.call_args_list if "push" in call.args)
+        self.assertIn("--force-with-lease=refs/heads/github/pr-1:" + "d" * 40, push.args)
+        self.assertNotIn("--force", push.args)
+
+    def test_closed_copy_does_not_resurrect_a_deleted_branch(self):
+        sync = self.fixture(previous={"state": "closed"})
+        sync.copy_one(1)
+        sync.gitea.assert_not_called()
+        self.assertFalse(any("push" in call.args for call in sync.command.call_args_list))
+
+    def test_all_state_listing_checks_later_pages(self):
+        sync = self.fixture()
+        sync.existing_pull = Sync.existing_pull.__get__(sync)
+        unrelated = {"head": {"ref": "other"}, "base": {"ref": "main"}}
+        matching = {"head": {"ref": "github/pr-1"}, "base": {"ref": "main"}, "state": "closed"}
+        sync.gitea.side_effect = [[unrelated] * 50, [matching]]
+        self.assertEqual(sync.existing_pull("github/pr-1"), matching)
+        self.assertIn("state=all", sync.gitea.call_args.args[1])
+        self.assertIn("page=2", sync.gitea.call_args.args[1])
+
+    def test_new_branch_requires_absence_lease(self):
+        sync = self.fixture()
+        sync.copy_one(1)
+        push = next(call for call in sync.command.call_args_list if "push" in call.args)
+        self.assertIn("--force-with-lease=refs/heads/github/pr-1:", push.args)
+
+    def test_api_lookup_failure_cannot_become_absence(self):
+        sync = self.fixture()
+        sync.existing_pull.side_effect = OSError("unavailable")
+        with self.assertRaises(OSError):
+            sync.copy_one(1)
+        sync.gitea.assert_not_called()
+        self.assertFalse(any("push" in call.args for call in sync.command.call_args_list))
+
+    def test_one_transport_failure_does_not_abort_other_prs(self):
+        sync = self.fixture()
+        sync.numbers = Mock(return_value=[1, 2])
+        sync.copy_one = Mock(side_effect=[OSError("network down"), "copied"])
+        self.assertEqual(sync.run(), 1)
+        self.assertEqual([call.args[0] for call in sync.copy_one.call_args_list], [1, 2])
+
+    def test_selection_failure_cannot_hide_a_missing_commit(self):
+        sync = self.fixture()
+        sync.env.update(EVENT="push", BEFORE="a" * 40, AFTER="b" * 40)
+        sync.command = Mock(return_value="c" * 40 + "\n" + "d" * 40)
+        sync.github = Mock(side_effect=OSError("lookup unavailable"))
+        with self.assertRaises(OSError):
+            sync.numbers()
+        self.assertEqual(sync.github.call_count, 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
