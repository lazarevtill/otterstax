--- /dev/null
+++ b/.github/scripts/sync_to_gitea.py
@@ -0,0 +1,156 @@
+"""Reconcile GitHub PR copies. Invoked only by the authorized sync workflow."""
+import base64
+import json
+import os
+import re
+import subprocess
+import sys
+import urllib.error
+import urllib.parse
+import urllib.request
+
+
+class Sync:
+    def __init__(self, environment):
+        self.env = dict(environment)
+        self.url = self.env["GITEA_URL"].rstrip("/")
+        parsed = urllib.parse.urlsplit(self.url)
+        if parsed.scheme != "https" or not parsed.netloc or parsed.username or parsed.query or parsed.fragment:
+            raise ValueError("GITEA_URL must be an HTTPS server URL")
+        self.repository = self.env["GITEA_REPO"]
+        if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", self.repository):
+            raise ValueError("GITEA_REPO must identify owner/repository")
+        self.remote = f"{self.url}/{self.repository}.git"
+
+    def command(self, *args, gitea=False):
+        environment = dict(self.env)
+        if gitea:
+            auth = base64.b64encode((environment["GITEA_TOKEN"] + ":x-oauth-basic").encode()).decode()
+            environment.update(GIT_CONFIG_COUNT="2", GIT_CONFIG_KEY_0="http.extraHeader",
+                               GIT_CONFIG_VALUE_0="Authorization: Basic " + auth,
+                               GIT_CONFIG_KEY_1="http.followRedirects", GIT_CONFIG_VALUE_1="false")
+        # Credentials are only in the environment; no token is an argv value.
+        completed = subprocess.run(args, env=environment, text=True, capture_output=True)
+        if completed.returncode:
+            raise RuntimeError(f"{args[0]} command failed (exit {completed.returncode})")
+        return completed.stdout.strip()
+
+    def github(self, path):
+        if path.startswith("commits/"):
+            pages = json.loads(self.command("gh", "api", "--paginate", "--slurp",
+                                             "repos/" + self.env["REPO"] + "/" + path + "?per_page=100"))
+            return [pull for page in pages for pull in page]
+        return json.loads(self.command("gh", "api", "repos/" + self.env["REPO"] + "/" + path))
+
+    def gitea(self, method, path, body=None):
+        request = urllib.request.Request(
+            f"{self.url}/api/v1/repos/{self.repository}/{path}", method=method,
+            data=None if body is None else json.dumps(body).encode(),
+            headers={"Authorization": "token " + self.env["GITEA_TOKEN"], "Content-Type": "application/json"})
+        # Redirects must not forward an Authorization header to another origin.
+        class NoRedirect(urllib.request.HTTPRedirectHandler):
+            def redirect_request(self, *args, **kwargs):
+                return None
+        opener = urllib.request.build_opener(NoRedirect)
+        with opener.open(request, timeout=30) as response:
+            return json.load(response)
+
+    def existing_pull(self, branch):
+        page = 1
+        while True:
+            pulls = self.gitea("GET", f"pulls?state=all&limit=50&page={page}")
+            if not isinstance(pulls, list):
+                raise ValueError("Unexpected Gitea pull request listing")
+            for pull in pulls:
+                if pull["head"]["ref"] == branch and pull["base"]["ref"] == "main":
+                    return pull
+            if len(pulls) < 50:
+                return None
+            page += 1
+
+    def numbers(self):
+        if self.env["EVENT"] == "workflow_dispatch":
+            value = self.env["INPUT_PR"]
+            if not re.fullmatch(r"[1-9][0-9]*", value):
+                raise ValueError("pr must be a positive PR number")
+            return [int(value)]
+        before, after = self.env["BEFORE"], self.env["AFTER"]
+        if not re.fullmatch(r"[0-9a-fA-F]{40}", before) or not re.fullmatch(r"[0-9a-fA-F]{40}", after):
+            raise ValueError("Invalid push commit identity")
+        commits = [after] if set(before) == {"0"} else self.command("git", "rev-list", "--reverse", f"{before}..{after}").splitlines()
+        numbers = []
+        for commit in commits:
+            # Any failed lookup aborts selection. It cannot silently produce a
+            # smaller successful batch from only the later commits.
+            for pull in self.github(f"commits/{commit}/pulls"):
+                if pull.get("merged_at") and pull["base"]["ref"] == "main" and pull["number"] not in numbers:
+                    numbers.append(pull["number"])
+        return numbers
+
+    def copy_one(self, number):
+        pull = self.github(f"pulls/{number}")
+        if not pull.get("merged_at") or pull["base"]["ref"] != "main":
+            return "not merged into main"
+        label = self.env["SKIP_LABEL"].casefold()
+        if any(item["name"].casefold() == label for item in pull["labels"]):
+            return "excluded by label"
+        branch = f"github/pr-{number}"
+        ref = "refs/heads/" + branch
+        remote_ref = self.command("git", "ls-remote", "--heads", self.remote, ref, gitea=True)
+        observed = ""
+        if remote_ref:
+            fields = remote_ref.split()
+            if len(fields) != 2 or fields[1] != ref or not re.fullmatch(r"[0-9a-f]{40}", fields[0]):
+                raise ValueError("Unexpected remote branch identity")
+            observed = fields[0]
+        previous_pull = self.existing_pull(branch)
+        force = self.env.get("INPUT_FORCE") == "true"
+        if previous_pull and not force:
+            return "existing pull request preserved"
+
+        head = pull["head"]["sha"]
+        merge = pull["merge_commit_sha"]
+        if not re.fullmatch(r"[0-9a-f]{40}", head) or not re.fullmatch(r"[0-9a-f]{40}", merge):
+            raise ValueError("Invalid GitHub commit identity")
+        self.command("git", "fetch", "--quiet", "--no-tags", "origin", head)
+        base = self.command("git", "merge-base", head, merge + "^1")
+        if not observed or force:
+            # An absent branch is also leased: a concurrent creator must not be
+            # overwritten. A force request leases the OID observed above.
+            self.command("git", "push", f"--force-with-lease={ref}:{observed}", self.remote,
+                         f"{head}:{ref}", gitea=True)
+        if previous_pull:
+            return "branch reconciled; existing pull request preserved"
+        disposition = "The existing branch was preserved; inspect its current history before rebasing." if observed and not force else (
+            "The branch contains the original GitHub head; rebase it onto the destination main before merging.")
+        body = (f"Copied from [{self.env['REPO']}#{number}]({pull['html_url']}).\n\n"
+                f"{disposition}\n\nOriginal GitHub base: `{base}`.\n\n" + (pull.get("body") or ""))
+        payload = {"head": branch, "base": "main", "title": f"WIP: [gh#{number}] {pull['title']}", "body": body}
+        try:
+            self.gitea("POST", "pulls", payload)
+        except urllib.error.HTTPError as error:
+            # A concurrent successful creator is success only after observing
+            # the actual copy, never merely because the server returned 409.
+            if error.code not in (409, 422) or not self.existing_pull(branch):
+                raise
+        return "branch and pull request reconciled"
+
+    def run(self):
+        failed = False
+        for number in self.numbers():
+            try:
+                print(f"#{number}: {self.copy_one(number)}", flush=True)
+            except Exception as error:
+                # Each PR has an error boundary. Transport failures do not
+                # prevent independent PRs in the same push from being attempted.
+                print(f"#{number}: reconciliation failed ({type(error).__name__})", file=sys.stderr, flush=True)
+                failed = True
+        return int(failed)
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(Sync(os.environ).run())
+    except Exception as error:
+        print(f"PR selection failed ({type(error).__name__})", file=sys.stderr)
+        sys.exit(1)
